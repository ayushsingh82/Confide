# Required — your NEAR AI Cloud API key
NEAR_API_KEY=sk-your-near-ai-cloud-api-key

# Optional overrides
NEAR_API_BASE=https://cloud-api.near.ai
PORT=4000
HOST=0.0.0.0

# CORS — comma-separated list of allowed origins (use * for any)
CORS_ORIGIN=http://localhost:3000

# Where the JSONL stores live (gitignored)
DATA_DIR=./data

# GitHub OAuth — register an OAuth App at https://github.com/settings/developers
# Authorization callback URL must be: ${HOST}/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public URLs used in the OAuth redirect dance
PUBLIC_BACKEND_URL=http://localhost:4000
PUBLIC_FRONTEND_URL=http://localhost:3000

# Random 32+ char hex, used to sign the session cookie
SESSION_SECRET=please-change-me-to-a-long-random-string
