# Required — your NEAR AI Cloud API key
NEAR_API_KEY=sk-your-near-ai-cloud-api-key

# Optional overrides
NEAR_API_BASE=https://cloud-api.near.ai
PORT=4000
HOST=0.0.0.0

# CORS — comma-separated list of allowed origins (use * for any)
CORS_ORIGIN=http://localhost:3000

# Where the JSONL stores live (gitignored)
DATA_DIR=./data
